Class {
	#name : 'OldCapellaObject',
	#superclass : 'Object',
	#instVars : [
		'id'
	],
	#category : 'Capella-import',
	#package : 'Capella',
	#tag : 'import'
}

{ #category : 'accessing' }
OldCapellaObject >> id [

	^ id
]

{ #category : 'accessing' }
OldCapellaObject >> id: anObject [

	id := anObject
]
